<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">

    <service name="createClsTask"
             engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="createClsTask"
             auth="true">

        <attribute name="title" type="String" mode="IN"/>
        <attribute name="description" type="String" mode="IN"/>
        <attribute name="assignedTo" type="String" mode="IN"/>
        <attribute name="statusId" type="String" mode="IN"/>
        <attribute name="dueDate" type="String" mode="IN"/>

        <!-- ✅ Auto-generated primary key -->
        <attribute name="taskId" type="String" mode="OUT"/>
    </service>



    <service name="updateClsTask" engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="updateClsTask" auth="true">
        <attribute name="taskId" type="String" mode="IN"/>
        <attribute name="title" type="String" mode="IN"/>
        <attribute name="description" type="String" mode="IN"/>
        <attribute name="assignedTo" type="String" mode="IN"/>
        <attribute name="statusId" type="String" mode="IN"/>
        <attribute name="dueDate" type="String" mode="IN"/>
    </service>

    <service name="deleteClsTask" engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="deleteClsTask" auth="true">
        <attribute name="taskId" type="String" mode="IN"/>
    </service>
    <service name="findClsTask"
             engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="findClsTask"
             auth="true">

        <!-- Filters -->
        <attribute name="taskId" type="String" mode="IN" optional="true"/>
        <attribute name="title" type="String" mode="IN" optional="true"/>
        <attribute name="assignedTo" type="String" mode="IN" optional="true"/>

        <!-- Pagination IN -->
        <attribute name="viewIndex" type="Integer" mode="IN" optional="true"/>
        <attribute name="viewSize" type="Integer" mode="IN" optional="true"/>

        <!-- Pagination OUT -->
        <attribute name="taskList" type="List" mode="OUT"/>
        <attribute name="listSize" type="Integer" mode="OUT"/>
        <attribute name="viewIndex" type="Integer" mode="OUT"/>
        <attribute name="viewSize" type="Integer" mode="OUT"/>
    </service>


    <!-- SECA LOG -->
    <service name="logClsTaskStatusChange"
             engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="logClsTaskStatusChange"
             auth="true">

        <attribute name="taskId" type="String" mode="IN" optional="false"/>
    </service>
    <service name="logClsTaskStatusCreate"
             engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="logClsTaskStatusCreate"
             auth="true">
    <attribute name="taskId" type="String" mode="IN" optional="false"/>
    </service>
    <service name="JobScheduler"
             engine="java"
             location="test.org.ClassroomTaskServices"
             invoke="JobScheduler"
             auth="false">
    </service>
    <service name="aiHelpService"
             engine="groovy"
             location="script.test.org.AIHelpService"
             invoke="run"
             auth="false">

        <attribute name="question" mode="IN" type="String"/>
        <attribute name="answer" mode="OUT" type="String"/>

    </service>



</services>
